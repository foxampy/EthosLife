{
  "name": "ethoslife-platform",
  "version": "3.0.0",
  "description": "EthosLife - Unified Health Ecosystem Platform. Comprehensive health operating system for individuals and humanity with AI coaching, social network, DAO governance, and tokenomics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm install --include=dev && ./node_modules/.bin/vite build",
    "db:init": "node -e \"require('./database').initDatabase().then(() => process.exit(0))\"",
    "db:migrate": "node scripts/migrate.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "health",
    "wellness",
    "ai",
    "web3",
    "fitness",
    "nutrition",
    "marketplace"
  ],
  "dependencies": {
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.6.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "node-telegram-bot-api": "^0.64.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "google-auth-library": "^9.0.0",
    "bcrypt": "^5.1.1",
    "nodemailer": "^6.9.7",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.8.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.13.6",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "ethers": "^6.9.0",
    "framer-motion": "^12.35.0",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.294.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "zustand": "^4.4.7"
  }
}
