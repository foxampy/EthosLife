# ============================================
# ETHOSLIFE - COMPLETE ENVIRONMENT CONFIGURATION
# Version: 3.0.0 (Production Ready)
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/ethoslife
PGSSLMODE=no-verify

# ============================================
# JWT CONFIGURATION (CRITICAL)
# ============================================
JWT_SECRET=your-jwt-secret-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# OAUTH (Google)
# ============================================
GOOGLE_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================
# STRIPE (Monetization)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly_xxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_premium_yearly_xxx
STRIPE_PRO_PRICE_ID=price_pro_monthly_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_xxx

# ============================================
# TELEGRAM BOT (SAFT Notifications)
# ============================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
FOUNDER_CHAT_ID=123456789
ADMIN_CHAT_IDS=123456789,987654321

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_KEY=your-super-secret-admin-key-change-this-in-production

# ============================================
# CORS & FRONTEND
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://ethoslife.vercel.app,https://ethoslife.onrender.app
FRONTEND_URL=http://localhost:5173

# ============================================
# AI/ML API KEYS (CRITICAL for AI Coach)
# ============================================
QWEN_API_KEY=sk-your-qwen-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ============================================
# EMAIL (SendGrid)
# ============================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# ============================================
# WEB3/CRYPTO
# ============================================
ALCHEMY_API_KEY=your-alchemy-api-key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your-api-key
PRIVATE_KEY=your-private-key-for-deployment-do-not-commit
ETHERSCAN_API_KEY=your-etherscan-api-key
POLYGONSCAN_API_KEY=your-polygonscan-api-key
REPORT_GAS=true

# ============================================
# AWS S3 (File Storage)
# ============================================
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=ethoslife-storage
AWS_REGION=us-east-1

# ============================================
# REDIS (Cache)
# ============================================
REDIS_URL=redis://localhost:6379
